# CosyVoice OpenAI Compatible API Configuration

# Model directory (local path or ModelScope repo ID)
# Examples:
#   - iic/CosyVoice-300M (ModelScope repo)
#   - /workspace/pretrained_models/CosyVoice-300M (local path)
MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B

# API server port
PORT=8000

# API server host
HOST=0.0.0.0

# CUDA device to use
# Examples:
#   - 0 (use GPU 0)
#   - 1 (use GPU 1)
#   - 0,1 (use GPU 0 and 1)
#   - -1 (use CPU)
DEVICE=0

# Optional: Enable optimizations
# Uncomment to enable JIT compilation
# LOAD_JIT=true

# Uncomment to enable TensorRT
# LOAD_TRT=true

# Uncomment to enable VLLM (CosyVoice2/3 only)
# LOAD_VLLM=true

# Uncomment to enable FP16 precision
# FP16=true

# TensorRT concurrent instances
# TRT_CONCURRENT=1

# Docker only: GPU IDs to use (comma-separated, e.g., "0,1" or "all")
# GPU_IDS=all
