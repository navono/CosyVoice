# CosyVoice OpenAI Compatible API Configuration
# All variables in this file will be loaded by Makefile and docker-compose.yml

# =============================================================================
# Model Configuration
# =============================================================================

# Model directory (local path or ModelScope repo ID)
# Examples:
#   - iic/CosyVoice-300M (ModelScope repo - will download automatically)
#   - /workspace/pretrained_models/CosyVoice-300M (local path inside container)
#   - For Docker: use the path INSIDE the container after volume mount
MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B

# =============================================================================
# API Server Configuration
# =============================================================================

# API server port
PORT=8000

# API server host
HOST=0.0.0.0

# =============================================================================
# GPU/Device Configuration
# =============================================================================

# CUDA device to use
# Examples:
#   - 0 (use GPU 0)
#   - 1 (use GPU 1)
#   - 0,1 (use GPU 0 and 1)
#   - -1 (use CPU)
DEVICE=0

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker image name
IMAGE_NAME=cosyvoice:openai-latest

# Docker only: GPU IDs to use (comma-separated, e.g., "0,1" or "all")
GPU_IDS=all

# =============================================================================
# Conda Configuration
# =============================================================================

# Conda environment name (for local development)
CONDA_ENV=cosyvoice

# =============================================================================
# Voice Samples Configuration
# =============================================================================

# HOST_VOICE_DIR: Local directory path on host machine containing voice samples
# VOICE_DIR: Path inside container (usually no need to change)
HOST_VOICE_DIR=/path/to/your/voice/samples
VOICE_DIR=/workspace/voices

# =============================================================================
# Optional: Model Optimizations
# =============================================================================

# Optional: Enable optimizations
# Uncomment to enable JIT compilation
# LOAD_JIT=true

# Uncomment to enable TensorRT
# LOAD_TRT=true

# Uncomment to enable VLLM (CosyVoice2/3 only)
# LOAD_VLLM=true

# Uncomment to enable FP16 precision
# FP16=true

# TensorRT concurrent instances
# TRT_CONCURRENT=1

# =============================================================================
# Voice Samples Usage
# =============================================================================

# Voice samples format:
# Place audio files (.mp3, .wav, .flac, etc.) and corresponding text files (.txt) in HOST_VOICE_DIR
# Example:
#   /mnt/e/OneDrive/data_sync/audio_samples/
#   ├── voice-sample1.wav
#   └── voice-sample1.txt
#
# Then use in API request:
#   "voice": "lf-style6.mp3"  or  "voice": "lf-style6"
# The system will automatically load the audio and text files
